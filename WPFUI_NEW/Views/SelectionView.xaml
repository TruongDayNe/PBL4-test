<UserControl x:Class="WPFUI_NEW.Views.SelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WPFUI_NEW.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:SelectionViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <!-- Gradient Background -->
        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>

        <!-- Modern Button Style -->
        <Style x:Key="SelectionButton" TargetType="Button">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#667eea"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect Color="#667eea" 
                                                  BlurRadius="15" 
                                                  ShadowDepth="0" 
                                                  Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              Margin="0,2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#667eea" Offset="0"/>
                                            <GradientStop Color="#764ba2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Key Mapping Button Style -->
        <Style x:Key="KeyMappingButton" TargetType="Button" BasedOn="{StaticResource SelectionButton}">
            <Setter Property="Width" Value="240"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="White" Opacity="0.9"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#764ba2"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <StaticResource ResourceKey="BackgroundGradient"/>
        </Grid.Background>

        <!-- Decorative Circles -->
        <Canvas>
            <Ellipse Width="300" Height="300" 
                     Canvas.Left="-100" Canvas.Top="-100"
                     Fill="White" Opacity="0.05"/>
            <Ellipse Width="200" Height="200" 
                     Canvas.Right="-50" Canvas.Bottom="-50"
                     Fill="White" Opacity="0.05"/>
        </Canvas>

        <!-- Main Content Card -->
        <Border Width="500" 
                Background="White"
                CornerRadius="20"
                Padding="50,40"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" 
                                  BlurRadius="40" 
                                  ShadowDepth="0" 
                                  Opacity="0.2"/>
            </Border.Effect>

            <StackPanel>
                <!-- Logo Placeholder -->
                <Border Width="240" 
                        Height="160" 
                        Background="#FFFFFF"
                        BorderBrush="#667eea"
                        BorderThickness="3"
                        CornerRadius="20"
                        HorizontalAlignment="Center">
                    <Image Source="/assets/logo.png"
                        Margin="10" Stretch="Fill"/>
                    <Border.Effect>
                        <DropShadowEffect Color="#667eea" 
                                          BlurRadius="20" 
                                          ShadowDepth="0" 
                                          Opacity="0.3"/>
                    </Border.Effect>
                </Border>

                <!-- Title -->
                <TextBlock Text="VIRTUAL SOFA" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Margin="0,25,0,5">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#667eea" Offset="0"/>
                            <GradientStop Color="#764ba2" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>

                <!-- Subtitle -->
                <TextBlock Text="Game Streaming Tool" 
                           FontSize="15" 
                           Foreground="#95A5A6"
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,35"/>

                <!-- Host & Client Buttons -->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            Margin="0,0,0,5">
                    <Button Content="🎮 Host" 
                            Style="{StaticResource SelectionButton}"
                            Command="{Binding ShowHostViewCommand}"
                            Margin="0,0,5,0"/>

                    <Button Content="📺 Client" 
                            Style="{StaticResource SelectionButton}"
                            Command="{Binding ShowClientViewCommand}"
                            Margin="5,0,0,0"/>
                </StackPanel>

                <!-- Key Mapping Button -->
                <Button Content="⌨ Key Mapping" 
                        Style="{StaticResource KeyMappingButton}"
                        Command="{Binding ShowKeyMappingViewCommand}"
                        HorizontalAlignment="Center"/>

                <!-- Welcome Text -->
                <TextBlock Text="Chào mừng! Vui lòng chọn một chế độ." 
                           FontSize="13" 
                           Foreground="#95A5A6"
                           HorizontalAlignment="Center" 
                           Margin="0,25,0,0"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>