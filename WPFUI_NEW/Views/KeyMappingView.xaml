<UserControl x:Class="WPFUI_NEW.Views.KeyMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WPFUI_NEW.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1080"
             d:DataContext="{d:DesignInstance vm:KeyMappingViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Gradient Background -->
        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>
        
        <!-- Tab Button Style -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="White" Opacity="0.7"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#667eea"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10,10,0,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#667eea" BlurRadius="10" ShadowDepth="0" Opacity="0.2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="White" Opacity="0.85"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#667eea"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#667eea" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="10,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#667eea" Opacity="0.2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Active">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#667eea" Offset="0"/>
                                <GradientStop Color="#764ba2" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Key Icon Style -->
        <Style x:Key="KeyIcon" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- Key Input Box Style -->
        <Style x:Key="KeyInputBox" TargetType="TextBox">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#667eea"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="5,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#667eea" Offset="0"/>
                                            <GradientStop Color="#764ba2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#667eea" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ScrollBar Style -->
        <Style x:Key="CustomScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="#E0E0E0" CornerRadius="4" Opacity="0.3"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Border x:Name="thumb" CornerRadius="4" Background="White"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumb" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar Grid.Column="1" 
                                     x:Name="PART_VerticalScrollBar"
                                     Value="{TemplateBinding VerticalOffset}"
                                     Maximum="{TemplateBinding ScrollableHeight}"
                                     ViewportSize="{TemplateBinding ViewportHeight}"
                                     Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                     Style="{StaticResource CustomScrollBar}"
                                     Margin="4,0,4,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#667eea" Offset="0"/>
                        <GradientStop Color="#764ba2" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect Color="#667eea" BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#667eea" BlurRadius="15" ShadowDepth="3" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <StaticResource ResourceKey="BackgroundGradient"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Tabs -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="CONTROLLER" 
                    Style="{StaticResource TabButton}" 
                    Tag="{Binding IsControllerTabActive}"
                    Command="{Binding ShowControllerTabCommand}"/>
            <Button Content="KEYBOARD" 
                    Style="{StaticResource TabButton}" 
                    Tag="{Binding IsKeyboardTabActive}"
                    Command="{Binding ShowKeyboardTabCommand}"/>
        </StackPanel>

        <!-- Main Content - KEYBOARD TAB -->
        <Grid Grid.Row="1" Margin="0,10,0,0" Visibility="{Binding IsKeyboardTabActive, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" BorderThickness="0" CornerRadius="0" Margin="10,0,0,10">
                <Border.Background>
                    <SolidColorBrush Color="White" Opacity="0.9"/>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#667eea" BlurRadius="15" ShadowDepth="0" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="SETTINGS" FontSize="18" FontWeight="Bold" Margin="20,25,20,15" Foreground="#667eea"/>
                    <Button Content="Common Keys" 
                            Style="{StaticResource SidebarButton}"
                            Tag="{Binding IsCommonKeysActive}"
                            Command="{Binding ShowCommonKeysCommand}"/>
                    <Button Content="Advanced Keys" 
                            Style="{StaticResource SidebarButton}"
                            Tag="{Binding IsAdvancedKeysActive}"
                            Command="{Binding ShowAdvancedKeysCommand}"/>
                </StackPanel>
            </Border>

            <!-- Key Mapping Area -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20"
                          Style="{StaticResource CustomScrollViewer}">
                <ItemsControl ItemsSource="{Binding CurrentKeyMappings}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" HorizontalAlignment="Left"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Background Border cho mỗi dòng -->
                            <Border Background="White" 
                                    CornerRadius="10" 
                                    Padding="12,8"
                                    Margin="8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#667eea" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Key Icon -->
                                    <Border Style="{StaticResource KeyIcon}">
                                        <TextBlock Text="{Binding KeyLabel}" 
                                                 FontSize="14" 
                                                 FontWeight="Bold"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Key Name -->
                                    <TextBlock Text="{Binding KeyName}" 
                                             FontSize="13"
                                             FontWeight="Medium"
                                             VerticalAlignment="Center"
                                             Width="70"
                                             Margin="0,0,10,0"
                                             Foreground="#555"/>

                                    <!-- Input Box -->
                                    <TextBox Style="{StaticResource KeyInputBox}"
                                           Text="{Binding MappedKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           PreviewKeyDown="KeyInputBox_PreviewKeyDown"
                                           GotFocus="KeyInputBox_GotFocus"
                                           Tag="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Main Content - CONTROLLER TAB -->
        <Grid Grid.Row="1" Visibility="{Binding IsControllerTabActive, Converter={StaticResource BoolToVis}}">
            <!-- ScrollViewer to allow scrolling for controller layout -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                          Style="{StaticResource CustomScrollViewer}">
                <!-- Canvas for absolute positioning - explicit size -->
                <Canvas Width="1250" Height="750">
                <!-- Controller Layout Image in Center -->
                <Image Source="/Images/controller-layout.png" 
                       Canvas.Left="300" Canvas.Top="-50"
                       Width="700" Height="506"
                       Opacity="1.0"
                       Panel.ZIndex="0"/>
                       
                <!-- LEFT SIDE MAPPINGS -->
                <!-- Left Bumper -->
                <Border Background="White" CornerRadius="8" Padding="10,8" 
                        Canvas.Left="10" Canvas.Top="20" Panel.ZIndex="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#667eea" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/Left Bumper.png" Width="30" Height="30" Margin="0,0,10,0"/>
                        <TextBlock Text=": Left Bumper" Width="120" VerticalAlignment="Center" FontSize="13" Foreground="#555"/>
                        <TextBox Style="{StaticResource KeyInputBox}"
                                Text="{Binding LeftShoulderMapping, Mode=TwoWay}"
                                PreviewKeyDown="ControllerInputBox_PreviewKeyDown"
                            GotFocus="KeyInputBox_GotFocus"
                            Tag="LeftShoulder"/>
                    </StackPanel>
                </Border>

                <!-- Left Trigger -->
                <Border Background="White" CornerRadius="8" Padding="10,8" Canvas.Left="10" Canvas.Top="95" Panel.ZIndex="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#667eea" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/Left Trigger.png" Width="30" Height="30" Margin="0,0,10,0"/>
                        <TextBlock Text=": Left Trigger" Width="120" VerticalAlignment="Center" FontSize="13" Foreground="#555"/>
                        <TextBox Style="{StaticResource KeyInputBox}"
                            Text="{Binding LeftTriggerMapping, Mode=TwoWay}"
                            PreviewKeyDown="ControllerInputBox_PreviewKeyDown"
                            GotFocus="KeyInputBox_GotFocus"
                            Tag="LeftTrigger"/>
                    </StackPanel>
                </Border>

                <!-- Left Stick Up -->
                <Border Background="White" CornerRadius="8" Padding="10,8" 
                        Canvas.Left="10" Canvas.Top="170" Panel.ZIndex="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#667eea" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/Left Stick Up.png" Width="30" Height="30" Margin="0,0,10,0"/>
                        <TextBlock Text=": Left Stick Up" Width="120" VerticalAlignment="Center" FontSize="13" Foreground="#555"/>
                        <TextBox Style="{StaticResource KeyInputBox}"
                                Text="{Binding LeftStickUpMapping, Mode=TwoWay}"
                                PreviewKeyDown="ControllerInputBox_PreviewKeyDown"
                                GotFocus="KeyInputBox_GotFocus"
                                Tag="LeftStickUp"/>
                    </StackPanel>
                </Border>

                <!-- Left Stick Right -->
                <Border Background="White" CornerRadius="8" Padding="10,8" 
                        Canvas.Left="10" Canvas.Top="245" Panel.ZIndex="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#667eea" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/Left Stick Right.png" Width="30" Height="30" Margin="0,0,10,0"/>
                        <TextBlock Text=": Left Stick Right" Width="120" VerticalAlignment="Center" FontSize="13" Foreground="#555"/>
                        <TextBox Style="{StaticResource KeyInputBox}"
                                Text="{Binding LeftStickRightMapping, Mode=TwoWay}"
                                PreviewKeyDown="ControllerInputBox_PreviewKeyDown"
                                GotFocus="KeyInputBox_GotFocus"
                                Tag="LeftStickRight"/>
                    </StackPanel>
                </Border>

                <!-- Left Stick Down -->
                <Border Background="White" CornerRadius="8" Padding="10,8" 
                        Canvas.Left="10" Canvas.Top="320" Panel.ZIndex="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#667eea" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/Left Stick Down.png" Width="30" Height="30" Margin="0,0,10,0"/>
                        <TextBlock Text=": Left Stick Down" Width="120" VerticalAlignment="Center" FontSize="13" Foreground="#555"/>
                        <TextBox Style="{StaticResource KeyInputBox}"
                                Text="{Binding LeftStickDownMapping, Mode=TwoWay}"
                                PreviewKeyDown="ControllerInputBox_PreviewKeyDown"
                                GotFocus="KeyInputBox_GotFocus"
                                Tag="LeftStickDown"/>
                    </StackPanel>
                </Border>

                <!-- Left Stick Left -->
                <Border Background="White" CornerRadius="8" Padding="10,8" 
                        Canvas.Left="10" Canvas.Top="395" Panel.ZIndex="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#667eea" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/Left Stick Left.png" Width="30" Height="30" Margin="0,0,10,0"/>
                        <TextBlock Text=": Left Stick Left" Width="120" VerticalAlignment="Center" FontSize="13" Foreground="#555"/>
                        <TextBox Style="{StaticResource KeyInputBox}"
                                Text="{Binding LeftStickLeftMapping, Mode=TwoWay}"
                                PreviewKeyDown="ControllerInputBox_PreviewKeyDown"
                                GotFocus="KeyInputBox_GotFocus"
                                Tag="LeftStickLeft"/>
                    </StackPanel>
                </Border>

                <!-- D-Pad Up -->
                <Border Background="White" CornerRadius="8" Padding="10,8" 
                        Canvas.Left="10" Canvas.Top="470" Panel.ZIndex="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#667eea" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/D-Pad Up.png" Width="30" Height="30" Margin="0,0,10,0"/>
                        <TextBlock Text=": D-Pad Up" Width="120" VerticalAlignment="Center" FontSize="13" Foreground="#555"/>
                        <TextBox Style="{StaticResource KeyInputBox}"
                                Text="{Binding DPadUpMapping, Mode=TwoWay}"
                                PreviewKeyDown="ControllerInputBox_PreviewKeyDown"
                                GotFocus="KeyInputBox_GotFocus"
                                Tag="DPadUp"/>
                    </StackPanel>
                </Border>

                <!-- D-Pad Right -->
                <Border Background="White" CornerRadius="8" Padding="10,8" 
                        Canvas.Left="10" Canvas.Top="545" Panel.ZIndex="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#667eea" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/D-Pad Right.png" Width="30" Height="30" Margin="0,0,10,0"/>
                        <TextBlock Text=": D-Pad Right" Width="120" VerticalAlignment="Center" FontSize="13" Foreground="#555"/>
                        <TextBox Style="{StaticResource KeyInputBox}"
                                Text="{Binding DPadRightMapping, Mode=TwoWay}"
                                PreviewKeyDown="ControllerInputBox_PreviewKeyDown"
                                GotFocus="KeyInputBox_GotFocus"
                                Tag="DPadRight"/>
                    </StackPanel>
                </Border>

                <!-- D-Pad Down -->
                <Border Background="White" CornerRadius="8" Padding="10,8" 
                        Canvas.Left="10" Canvas.Top="620" Panel.ZIndex="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#667eea" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/D-Pad Down.png" Width="30" Height="30" Margin="0,0,10,0"/>
                        <TextBlock Text=": D-Pad Down" Width="120" VerticalAlignment="Center" FontSize="13" Foreground="#555"/>
                        <TextBox Style="{StaticResource KeyInputBox}"
                                Text="{Binding DPadDownMapping, Mode=TwoWay}"
                                PreviewKeyDown="ControllerInputBox_PreviewKeyDown"
                                GotFocus="KeyInputBox_GotFocus"
                                Tag="DPadDown"/>
                    </StackPanel>
                </Border>

                <!-- D-Pad Left -->
                <Border Background="White" CornerRadius="8" Padding="10,8" 
                        Canvas.Left="10" Canvas.Top="695" Panel.ZIndex="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#667eea" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/D-Pad Left.png" Width="30" Height="30" Margin="0,0,10,0"/>
                        <TextBlock Text=": D-Pad Left" Width="120" VerticalAlignment="Center" FontSize="13" Foreground="#555"/>
                        <TextBox Style="{StaticResource KeyInputBox}"
                                Text="{Binding DPadLeftMapping, Mode=TwoWay}"
                                PreviewKeyDown="ControllerInputBox_PreviewKeyDown"
                                GotFocus="KeyInputBox_GotFocus"
                                Tag="DPadLeft"/>
                    </StackPanel>
                </Border>

                <!-- RIGHT SIDE MAPPINGS -->
                <!-- Right Bumper -->
                <Border Background="White" CornerRadius="8" Padding="10,8" 
                        Canvas.Left="950" Canvas.Top="20" Panel.ZIndex="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#667eea" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/Right Bumper.png" Width="30" Height="30" Margin="0,0,10,0"/>
                        <TextBlock Text=": Right Bumper" Width="120" VerticalAlignment="Center" FontSize="13" Foreground="#555"/>
                        <TextBox Style="{StaticResource KeyInputBox}"
                                Text="{Binding RightShoulderMapping, Mode=TwoWay}"
                                PreviewKeyDown="ControllerInputBox_PreviewKeyDown"
                                GotFocus="KeyInputBox_GotFocus"
                                Tag="RightShoulder"/>
                    </StackPanel>
                </Border>

                <!-- Right Trigger -->
                <Border Background="White" CornerRadius="8" Padding="10,8" 
                        Canvas.Left="950" Canvas.Top="95" Panel.ZIndex="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#667eea" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/Right Trigger.png" Width="30" Height="30" Margin="0,0,10,0"/>
                        <TextBlock Text=": Right Trigger" Width="120" VerticalAlignment="Center" FontSize="13" Foreground="#555"/>
                        <TextBox Style="{StaticResource KeyInputBox}"
                                Text="{Binding RightTriggerMapping, Mode=TwoWay}"
                                PreviewKeyDown="ControllerInputBox_PreviewKeyDown"
                                GotFocus="KeyInputBox_GotFocus"
                                Tag="RightTrigger"/>
                    </StackPanel>
                </Border>

                <!-- Y Button -->
                <Border Background="White" CornerRadius="8" Padding="10,8" 
                        Canvas.Left="950" Canvas.Top="170" Panel.ZIndex="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#667eea" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/Y.png" Width="30" Height="30" Margin="0,0,10,0"/>
                        <TextBlock Text=": Y Button" Width="120" VerticalAlignment="Center" FontSize="13" Foreground="#555"/>
                        <TextBox Style="{StaticResource KeyInputBox}"
                                Text="{Binding ButtonYMapping, Mode=TwoWay}"
                                PreviewKeyDown="ControllerInputBox_PreviewKeyDown"
                                GotFocus="KeyInputBox_GotFocus"
                                Tag="ButtonY"/>
                    </StackPanel>
                </Border>

                <!-- B Button -->
                <Border Background="White" CornerRadius="8" Padding="10,8" 
                        Canvas.Left="950" Canvas.Top="245" Panel.ZIndex="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#667eea" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
