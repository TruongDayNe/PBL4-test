        <!-- Footer -->
        <Border Grid.Row="2" 
                BorderThickness="0"
                CornerRadius="0"
                Margin="10,0,10,10"
                Padding="20">
            <Border.Background>
                <SolidColorBrush Color="White" Opacity="0.9"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#667eea" BlurRadius="15" ShadowDepth="0" Opacity="0.2"/>
            </Border.Effect>
            <Grid>
                <!-- Footer text changes based on tab -->
                <TextBlock FontSize="15" FontWeight="Medium" VerticalAlignment="Center" Foreground="#667eea">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Create a custom keyboard scheme"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsControllerTabActive}" Value="True">
                                    <Setter Property="Text" Value="Create a custom control scheme"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="⌨ Confirm" 
                            Style="{StaticResource ActionButton}"
                            Command="{Binding ConfirmCommand}"
                            Margin="0,0,10,0"/>
                    <Button Content="⌫ Back" 
                            Style="{StaticResource ActionButton}"
                            Command="{Binding BackToMenuCommand}">
                        <Button.Background>
                            <SolidColorBrush Color="#95a5a6" Opacity="0.9"/>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </Grid>
            </Border>
    </Grid>
</UserControl>

